{
  "name": "contratacion-estado-json",
  "version": "1.0.0",
  "description": "Anuncios de contratación del Ayuntamiento de Aranda de Duero (Plataforma de Contratación del Sector Público): descarga diaria, página de transparencia y calendario.",
  "main": "index.js",
  "scripts": {
    "fetch": "node index.js",
    "build:site": "node transparencia/build.js",
    "lint": "eslint .",
    "test": "c8 ava"
  },
  "engines": {
    "node": ">=26"
  },
  "ava": {
    "files": [
      "test/**/*.test.js"
    ],
    "timeout": "60s"
  },
  "c8": {
    "include": [
      "lib/**",
      "transparencia/extract.js",
      "transparencia/build.js"
    ],
    "reporter": [
      "text",
      "lcov"
    ],
    "check-coverage": true,
    "lines": 90,
    "branches": 80,
    "functions": 90
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1152.0",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ava": "^8.0.2",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
