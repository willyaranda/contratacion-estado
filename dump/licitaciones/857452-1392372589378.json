      "cac:TendererQualificationRequest": {
        "cac:TechnicalEvaluationCriteria": [
          {
            "cbc:EvaluationCriteriaTypeCode": {
              "#text": "ZZZ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/TechnicalCapabilityTypeCode-2.0.gc"
            },
            "cbc:Description": "Que disponga de un equipo técnico altamente cualificado que se persone en el plazo máximo de 24 horas para la resolución de problemas especialmente complejos, documentándolo mediante los correspondientes curriculum"
          },
          {
            "cbc:EvaluationCriteriaTypeCode": {
              "#text": "OSR-COMPTASK",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/TechnicalCapabilityTypeCode-2.0.gc"
            },
            "cbc:Description": "Experiencia de más de diez años en la instalación de sistemas de control de accesos centralizados con gestión propia de expedientes"
          },
          {
            "cbc:EvaluationCriteriaTypeCode": {
              "#text": "OSR-COMPTASK",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/TechnicalCapabilityTypeCode-2.0.gc"
            },
            "cbc:Description": "Acreditación como mínimo de tres contratos de características similares durante los últimos tres años"
          },
          {
            "cbc:EvaluationCriteriaTypeCode": {
              "#text": "OXR-MEDIOS",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/TechnicalCapabilityTypeCode-2.0.gc"
            },
            "cbc:Description": "Que disponga de los medios y materiales necesarios para afrontar las responsabilidades de este contrato, garantizando durante la duración del mismo la disponibilidad de repuestos de todos los elementos que componen los sistemas objeto del contrato"
          },
          {
            "cbc:EvaluationCriteriaTypeCode": {
              "#text": "OSR-COMPTASK",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/TechnicalCapabilityTypeCode-2.0.gc"
            },
            "cbc:Description": "Experiencia de más de cinco años en la realización de trabajos deinstalación, mantenimiento, conservación y explotación de contrl de accesos en ciudades de más de 50.000 habitantes"
          },
          {
            "cbc:EvaluationCriteriaTypeCode": {
              "#text": "OSR-TECH",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/TechnicalCapabilityTypeCode-2.0.gc"
            },
            "cbc:Description": "Tecnología desarrollada por el propio contratista que implique al menos, desarrollos de software destinado a la gestión de expedientes, tarjetas de acceso, distintivos y demás requerimientos.con una antigüedad de más de cinco años de funcionamiento."
          }
        ],
        "cac:FinancialEvaluationCriteria": {
          "cbc:EvaluationCriteriaTypeCode": {
            "#text": 3,
            "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/TechnicalCapabilityTypeCode-2.0.gc"
          },
          "cbc:Description": "Póliza de responsabilidad civil del ofertante con un importe mínimo de cobertura de 300.000 € justificando su vigencia con el recibo pagado, o compromiso de suscribirla en caso de ser adjudicatario y mantenerla hasta el vencimiento del plazo de garantía"
