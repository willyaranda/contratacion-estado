      "cac:AwardingTerms": {
        "cac:AwardingCriteria": [
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "OBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "Cobertura de póliza de responsabilidad civil (con un mínimo de 754.764 €). Conforme Anexo X del CCP PCAP.",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 2,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 8
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "SUBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "La composición artística (hasta 7 puntos). Se apreciará la acertada combinación de efectos, su espectacularidad y la creatividad de la composición. Conforme Anexo IX del CCP PCAP.",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 99,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaNotAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 7
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "SUBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "La originalidad y estructuración (hasta 6 puntos). Se apreciará la versatilidad de los castillos, la incorporación de efectos novedosos y su variedad. Conforme Anexo IX del CCP PCAP.",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 99,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaNotAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 6
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "OBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "Oferta técnica hasta 35 puntos. Conforme Anexo X del CCP PCAP.",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 2,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 35
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "OBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "Premios. Se otorgará 1 punto por cada premio obtenido en un concurso de fuegos artificiales desde 2017, hasta un máximo de 7 puntos. Deberá acreditarse con certificación oficial. Conforme Anexo X del CCP PCAP.",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 2,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 7
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "SUBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "La innovación y actualidad de los artificios (hasta 6 puntos). En este punto se tendrán en cuenta las técnicas aplicadas, repercusiones de carácter medioambiental, o el vanguardismo testado en aspectos logísticos, de organización, de seguridad o de composición del explosivo. Conforme Anexo IX del CCP PCAP.",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 99,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaNotAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 6
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "SUBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "El ritmo y la cadencia de disparo (hasta 6 puntos). Se apreciará el dinamismo de la composición, la retención posible al espectador y una trayectoria in crescendo. Conforme Anexo IX del CCP PCAP.",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 99,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaNotAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 6
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "OBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "La mayor ventaja económica, hasta un máximo de 25 puntos. Conforme Anexo X del CCP PCAP.",
