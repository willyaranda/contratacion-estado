          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "OBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "Criterios objetivos de calidad. Se valorará si contiene una entrada de césped artificial que cubra el lateral de la fachada de la Iglesia de San Juan que está dentro del Balcón de San Juan",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 2,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 2
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "SUBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "Propuesta de decoración interiorismo y mobiliario. Se valorará el diseño de ploter vinilado a modo de mural para decorar la pared del fondo del Recinto Ferial de medidas 20*2.5 metros",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 99,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaNotAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 3
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "SUBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "Diseño del espacio relacional y de sombra: empleo de técnicas de decoración vanguardistas y la propuesta de iluminación e identificación de la nueva marca Premios Envero de forma visible, desde cualquier parte del Parque de la Isla.",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 99,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaNotAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 4
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "OBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "OFERTA ECONÓMICA Menor Precio (49 puntos) Conforme Anexo X del PCAP CCP.",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 1,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 49
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "SUBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "Diseño de las estructuras de las dos barras de Envero Bar. Se valorará la mejor configuración y distribución de los espacios: zona de relación, zonas de Envero Bar y zona de tickets.",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 99,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaNotAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 3
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "SUBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "Propuesta de decoración interiorismo y mobiliario. Se valorará el diseño de la estructura a modo de pórtico: el empleo de técnicas de decoración vanguardistas y la propuesta de iluminación e identificación de la nueva marca Premios Envero de forma visible, desde cualquier parte del Recinto Ferial interior.",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 99,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaNotAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 6
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "SUBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "Diseño de las estructuras de las dos barras de Envero Bar. Se valorará el empleo de técnicas de decoración vanguardistas y la propuesta de iluminación e identificación de la marca Premios Envero de forma visible, tanto en el espacio interior del recinto como en el Parque de la Isla.",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 99,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaNotAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 5
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "SUBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "Propuesta de decoración interiorismo y mobiliario. Se valorará la propuesta del muro/pared vegetal que separa la gran sala de cata de la zona del Envero Bar en el Recinto Ferial",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 99,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaNotAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 4
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "OBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "Criterios objetivos de calidad. Para el espacio de del Balcón de San Juan de la gala se valorará el espacio de techado que se diseñe con sus anclajes y decoración: 100 metros cuadrados 1 punto, 200 metros cuadrados 2 puntos, 300 metros cuadrados 3 puntos.",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 2,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 3
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "SUBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "Diseño de las estructuras de las dos barras de Envero Bar. Se valorará la distribución de la información que da visibilidad a los distintos vinos que se ofrecerán.",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 99,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaNotAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 2
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "OBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "Criterios objetivos de calidad. Fotografía de la disposición de un puesto de catador, acorde al detalle del presente pliego.",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 2,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 2
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "SUBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "Proyecto innovador para el acondicionamiento acústico del espacio interior del Recinto Ferial: se valorará que la propuesta contenga la solución de sonido y tecnología adecuada que destaque por su novedad y que sea elaborada y suscrita por un ingeniero de sonido en el que habrá determinará qué mejoras se las conseguirán con la implantación de dicha solución. Al efecto se proporcionarán los equipos de cobertura de la anterior edicion.",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 99,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaNotAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 10
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "SUBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "Detalle de distribución en el Balcón de San Juan de cómo se situarán las mesas definidas en el Pliego de Prescripciones Técnicas, incluyendo fotografías y alérgenos de los menús, valorándose la alta cocina de los mismos y el maridaje con los vinos de las distintas categorías del certamen y nombre del cocinero/a o empresa de catering que lo vaya a proporcionar.",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 99,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaNotAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 3
          }
