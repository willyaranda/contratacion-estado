          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "OBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "En cada curso de monitor de tiempo libre que se imparta, por realizar actividades extraordinarias relacionadas con el temario, fuera del aula y no contempladas en el pliego, con una duración mínima de 2 horas y máxima de 5 horas",
