              "#text": "OBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "Oferta económica. Menor precio- Conforme Anexo X del CCP del PCAP",
            "cbc:AwardingCriteriaSubTypeCode": {
              "#text": 1,
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.09/AwardingCriteriaAutomaticallyEvaluatedSubTypeCode-2.09.gc"
            },
            "cbc:WeightNumeric": 49
          },
          {
            "cbc:AwardingCriteriaTypeCode": {
              "#text": "OBJ",
              "@_listURI": "http://contrataciondelestado.es/codice/cl/2.0/AwardingCriteriaCode-2.0.gc"
            },
            "cbc:Description": "Por impartir cursos monográficos relacionados con el tiempo libre -uno por cada año que dure el contrato-, en época no lectiva y con duración mínima de 20 horas cada curso",
